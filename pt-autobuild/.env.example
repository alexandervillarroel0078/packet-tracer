# Proveedor de IA para la autocalibracion: openai | anthropic
AI_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys). El modelo debe tener vision.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
